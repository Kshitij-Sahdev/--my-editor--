# =============================================================================
# .env.example — Code Runner Environment Variables
#
# Copy this to .env for local development, or set these in Coolify's
# "Environment Variables" panel for production.
# =============================================================================

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Port the Go server listens on (Coolify/Traefik handles external 443/80)
PORT=8080

# ---------------------------------------------------------------------------
# Execution limits
# ---------------------------------------------------------------------------

# Max simultaneous code executions per client IP
MAX_CONCURRENT=3

# Timeout for batch /api/run requests (seconds)
TIMEOUT_BATCH=10

# Timeout for interactive WebSocket /api/ws sessions (seconds)
TIMEOUT_STREAM=300

# Max bytes accepted for source code (default: 65536 = 64KB)
MAX_CODE_SIZE=65536

# Max bytes accepted for stdin input (default: 1048576 = 1MB)
MAX_STDIN_SIZE=1048576

# Max bytes captured from stdout/stderr (default: 1048576 = 1MB)
MAX_OUTPUT_SIZE=1048576

# ---------------------------------------------------------------------------
# Coolify-managed (do not set manually — Coolify injects these)
# ---------------------------------------------------------------------------

# Your public domain — Coolify sets this automatically
# SERVICE_FQDN_APP=coderunner.yourdomain.com
