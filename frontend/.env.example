# Backend API URL (defaults to http://localhost:8080)
VITE_API_URL=http://localhost:8080

# Judge0 API Configuration (for fallback execution)
# Get your API key from: https://rapidapi.com/judge0-official/api/judge0-ce
VITE_JUDGE0_API=https://judge0-ce.p.rapidapi.com
VITE_JUDGE0_API_KEY=rapidapi_key

# Clerk Authentication
# Get your publishable key from https://dashboard.clerk.com
# Enable Google + GitHub OAuth in Clerk dashboard
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_key_here
